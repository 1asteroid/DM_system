# Backend Configuration
# PRODUCTION: DEBUG must be False (hides /docs, /redoc, disables SQL logging)
DEBUG=False
# PRODUCTION: generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
# PRODUCTION: recommend reducing to 30 minutes for tighter security
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50
# PRODUCTION: set to your actual frontend domain
DOMAIN=yourdomain.com
ALLOWED_ORIGINS=["https://yourdomain.com"]

# Database Configuration
# cPanel/shared-hosting variant:
# DATABASE_URL=sqlite+aiosqlite:///./data/diplom.db
# VPS/PostgreSQL variant:
DATABASE_URL=postgresql+asyncpg://postgres:your_password@db:5432/diplom_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=diplom_db

# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here
API_URL=http://backend:8000/api/v1
ADMIN_IDS=
